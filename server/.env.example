# Postgres connection (F0.1) — Supabase live (D29)
# Take from: Supabase Dashboard -> Connect -> Session pooler (IPv4 + transaction-safe)
# Replace [YOUR-PASSWORD] and note: % -> %25, ! -> %21 (URL-encode special chars!)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
PGSSL=true

# Supabase API (F0.2 auth) — from: Dashboard -> Connect (API keys block)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json

# Local dev fallback (portable Postgres at %USERPROFILE%\pg-dev, started via pg_ctl):
# DATABASE_URL=postgresql://postgres@localhost:5432/gtm
# PGSSL=false